{
	"redirects": [
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "rowdybyte.xyz"
				}
			],
			"destination": "https://www.rowdybyte.xyz/:path*",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "index, follow"
				}
			]
		}
	]
}
